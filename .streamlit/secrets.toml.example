# Streamlit Secrets Template for Cloud & Local Deployment
# On Streamlit Community Cloud: Paste these into App Settings -> Secrets
# For local testing without .env: Copy this file to .streamlit/secrets.toml

# Groq API Key for live AI generation (Get your free key at https://console.groq.com)
GROQ_API_KEY = "gsk_your_groq_api_key_here"

# (Optional) Google Gemini API Key fallback
# GEMINI_API_KEY = "your_gemini_api_key_here"
